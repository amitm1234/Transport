<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/journey_bg">

    <!-- 1. Top ~30% Decorative Faint Dotted Route Line -->
    <View
        android:id="@+id/vTopDecorLine"
        android:layout_width="160dp"
        android:layout_height="2dp"
        android:layout_marginTop="50dp"
        android:layout_marginEnd="-20dp"
        android:background="@drawable/bg_top_dotted_decor"
        android:rotation="-15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Center Content Section: App Icon + Title + Tagline -->
    <LinearLayout
        android:id="@+id/layoutCenterBranding"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toTopOf="@id/layoutRouteSection"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.42">

        <!-- App Icon: VectorDrawable Green Rounded Square with bold "T" -->
        <ImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="16dp"
            android:contentDescription="App Icon"
            android:src="@drawable/ic_journey_app_icon" />

        <!-- Title: "TRANSPORT" (Populates via Typewriter Animation) -->
        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:textColor="@color/journey_primary"
            android:textSize="36sp"
            android:textStyle="bold" />

        <!-- Tagline: "Smart Transport Management" -->
        <TextView
            android:id="@+id/txtTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:text="Smart Transport Management"
            android:textColor="@color/journey_text"
            android:textSize="15sp" />

    </LinearLayout>

    <!-- 3. Bottom Journey Route Section (The Truck Journey IS the Loading Indicator) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutRouteSection"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginBottom="40dp"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/txtVersion"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Dotted Route Line -->
        <View
            android:id="@+id/vRouteDotted"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_route_dotted"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/imgDestPin"
            app:layout_constraintStart_toEndOf="@id/imgStartPin"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Solid Green Progress Line (Expands behind truck as it drives) -->
        <View
            android:id="@+id/vRouteSolidProgress"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:background="@drawable/bg_route_solid"
            app:layout_constraintBottom_toBottomOf="@id/vRouteDotted"
            app:layout_constraintStart_toEndOf="@id/imgStartPin"
            app:layout_constraintTop_toTopOf="@id/vRouteDotted" />

        <!-- Start Pin (Left) -->
        <ImageView
            android:id="@+id/imgStartPin"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Start Pin"
            android:src="@drawable/ic_pin_start"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Destination Pin (Right) -->
        <ImageView
            android:id="@+id/imgDestPin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Destination Pin"
            android:src="@drawable/ic_pin_dest"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Driving Truck (Sits on top of the route line) -->
        <ImageView
            android:id="@+id/imgTruck"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:contentDescription="Journey Truck"
            android:src="@drawable/ic_journey_truck"
            app:layout_constraintBottom_toTopOf="@id/vRouteDotted"
            app:layout_constraintStart_toEndOf="@id/imgStartPin"
            app:layout_constraintTop_toTopOf="@id/vRouteDotted" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 4. Bottom Edge Version Text -->
    <TextView
        android:id="@+id/txtVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="v1.0"
        android:textColor="@color/journey_subtext"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
