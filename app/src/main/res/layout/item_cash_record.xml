<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#F1F5F9">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3">

        <!-- Ref No Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_sell"
                app:tint="#0284C7" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ref No"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashRefNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ref #1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#0284C7" />
            </LinearLayout>
        </LinearLayout>

        <!-- Date Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_calendar"
                app:tint="#64748B" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Date"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="01/01/2025"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#1A1C1E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vehicle Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_vehicles"
                app:tint="#3B82F6" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Vehicle"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashVehicle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MH12AB1234"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1A1C1E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Factory Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_factory"
                app:tint="#64748B" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Factory"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashFactory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Factory A"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1A1C1E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Weight Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/scale_icon"
                app:tint="#376DC8" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Weight"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashWeight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 ton"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#1A1C1E" />
            </LinearLayout>
        </LinearLayout>

        <!-- Amount Box -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:orientation="horizontal"
            android:padding="12dp"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_border">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/coin"
                app:tint="#16A34A" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount"
                    android:textSize="10sp"
                    android:textColor="#64748B" />
                <TextView
                    android:id="@+id/txtCashAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹ 0"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#16A34A" />
            </LinearLayout>
        </LinearLayout>

    </GridLayout>

</com.google.android.material.card.MaterialCardView>
